{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/calculateur",
      "has": [
        {
          "type": "query",
          "key": "mode",
          "value": "export"
        }
      ],
      "destination": "/demande?service=exportation",
      "permanent": false
    },
    {
      "source": "/transport-conteneur-copart-iaai",
      "destination": "/transport-conteneur-vehicules",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "adtranslogistics.com"
        }
      ],
      "destination": "https://www.adtranslogistics.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(referentiel_douane|argus_4616_reference|vehicles_db|config|cookie-consent|achat-vehicules)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": "node build-public.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/sim-pay.js": {
      "includeFiles": "{lib/**,data/argus4616-catalogue.json,assets/vendor/jspdf.umd.min.js,assets/logo-adtl-20260919.jpeg}",
      "maxDuration": 60
    },
    "api/goods.js": {
      "includeFiles": "{lib/**,assets/goods-budget.js,assets/vendor/jspdf.umd.min.js,assets/logo-adtl-20260919.jpeg}",
      "maxDuration": 60
    }
  }
}
